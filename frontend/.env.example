# URL base de la API del backend (Laravel). DEBE terminar en /api
# - Todo en una sola PC (demo académica): usa localhost
VITE_API_URL=http://localhost:8000/api

# - Varios dispositivos en la MISMA red (LAN universitaria):
#   reemplaza por la IP local de la PC que corre el backend, p. ej.:
# VITE_API_URL=http://192.168.1.50:8000/api

# - Túnel público (ngrok / Cloudflare Tunnel), p. ej.:
# VITE_API_URL=https://tu-subdominio.ngrok-free.app/api
